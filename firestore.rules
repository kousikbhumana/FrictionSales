rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Target the specific user document
    match /users/{userId} {
      
      // The user must be logged in (request.auth != null)
      // AND the user's Auth ID must perfectly match the document ID they are trying to access
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
    }
  }
}
